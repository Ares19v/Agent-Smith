# ==============================================================================
#  Agent Smith — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  The .env file is gitignored and will never be committed.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── NLP / Core Engine ─────────────────────────────────────────────────────────
# Minimum confidence score for the MLP to commit to an intent (0.0 – 1.0).
# Lower = more permissive. Higher = stricter (more fallbacks).
CONFIDENCE_THRESHOLD=0.30

# Rolling window of past conversation turns used as classifier context.
CONTEXT_WINDOW=2

# Maximum number of turns stored per session.
SESSION_MEMORY_SIZE=10

# ── Document Upload ───────────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes.
MAX_DOC_SIZE_MB=10

# ── Optional: LLM Fallback ────────────────────────────────────────────────────
# Uncomment and fill in to enable cloud LLM fallback in core_engine.py
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# ── Optional: Local LLM (Ollama) ─────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Optional: Voice (Whisper) ─────────────────────────────────────────────────
# WHISPER_MODEL=base
